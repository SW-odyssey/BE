# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git에서 제외된다.
# supabase 프로파일이 읽는다. 값은 Supabase 대시보드 Connect → Session pooler 에 있고, 비밀번호는 팀원에게 따로 받는다.

SPRING_DATASOURCE_URL=jdbc:postgresql://<Session pooler 호스트>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project ref>
SPRING_DATASOURCE_PASSWORD=
